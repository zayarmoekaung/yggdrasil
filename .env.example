# LLM Provider Configuration
# mode: "qwen" or "kobold"
LLM_MODE=qwen

# Qwen (Dashscope / OpenRouter)
QWEN_API_KEY=your-api-key-here
QWEN_MODEL=qwen-turbo
QWEN_NARRATIVE_MODEL=qwen-plus
# Optional: if using OpenRouter instead
# QWEN_BASE_URL=https://openrouter.ai/api/v1

# KoboldCPP (local OpenAI-compatible server)
KOBOLD_BASE_URL=http://localhost:5001/v1
KOBOLD_MODEL=local-model
KOBOLD_NARRATIVE_MODEL=local-model

# Database
DB_PATH=./aetherdm.db
